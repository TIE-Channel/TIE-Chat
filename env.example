# --- required ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ
GEMINI_API_KEY=AIza...

# --- optional ---------------------------------------------------------
# Model to use. If your key can't access it, the bot auto-picks a flash model.
GEMINI_MODEL=gemini-3.8-flash

# Messages of context kept per chat (user + bot combined)
HISTORY_TURNS=20

# Seconds between two auto-replies in the same chat
REPLY_COOLDOWN=2

# Telegram user IDs that should never get an auto-reply, comma separated
IGNORE_USER_IDS=

TEMPERATURE=1.0

# Covers thinking AND the visible answer. Too low and Gemini 3 spends the whole
# budget reasoning and returns nothing. Don't go below ~1024.
MAX_OUTPUT_TOKENS=2048

# minimal | low | medium | high, or empty to let the model decide.
# A short chat reply needs no deep reasoning - low keeps it fast.
GEMINI_THINKING_LEVEL=low

GEMINI_TIMEOUT=45
LOG_LEVEL=INFO

# Override the whole personality. Leave unset to use the built-in one.
# PERSONA=You are a polite assistant. Always reply in the customer's language.
