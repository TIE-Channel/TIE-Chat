# --- required ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ
GEMINI_API_KEY=AIza...

# --- optional ---------------------------------------------------------
# Model to use. If your key can't access it, the bot auto-picks a flash model.
GEMINI_MODEL=gemini-3.8-flash

# Messages of context kept per chat (user + bot combined)
HISTORY_TURNS=20

# Seconds between two auto-replies in the same chat
REPLY_COOLDOWN=2

# Telegram user IDs that should never get an auto-reply, comma separated
IGNORE_USER_IDS=

TEMPERATURE=1.0
MAX_OUTPUT_TOKENS=800
LOG_LEVEL=INFO

# Override the whole personality. Leave unset to use the built-in one.
# PERSONA=You are a polite assistant. Always reply in the customer's language.
