# --- required ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ
GEMINI_API_KEY=AIza...

# --- lock it to you ---------------------------------------------------
# Your Telegram user id. WITHOUT THIS, anyone who knows the bot's username
# can attach it to their own Telegram Business account and answer their
# customers on your Gemini quota. Find it in the log line
# "business connection ... owner=NNNNN", or ask @userinfobot.
OWNER_ID=191609600

# Leave groups you are not a member of, instead of just staying quiet there.
GROUP_AUTO_LEAVE=false

# --- optional ---------------------------------------------------------
# Model to use. If your key can't access it, the bot auto-picks a flash model.
GEMINI_MODEL=gemini-3.8-flash

# Messages of context kept per chat (user + bot combined)
HISTORY_TURNS=20

# Seconds between two auto-replies in the same chat
REPLY_COOLDOWN=2

# Telegram user IDs that should never get an auto-reply, comma separated
IGNORE_USER_IDS=

# Quote the customer's message in the reply. Off by default - replies arrive as
# ordinary messages. Set to true to get the quoted-reply style back.
QUOTE_REPLIES=false

TEMPERATURE=1.0

# Covers thinking AND the visible answer. Too low and Gemini 3 spends the whole
# budget reasoning and returns nothing. Don't go below ~1024.
MAX_OUTPUT_TOKENS=2048

# minimal | low | medium | high, or empty to let the model decide.
# A short chat reply needs no deep reasoning - low keeps it fast.
GEMINI_THINKING_LEVEL=low

GEMINI_TIMEOUT=45
LOG_LEVEL=INFO

# Before anything shows in the chat: reaching the phone, unlocking it and
# reading the message. Pickup time is random between READ_MIN and READ_MAX,
# plus the time to read the incoming text at READ_CPS chars/sec.
READ_MIN=3
READ_MAX=12
READ_CPS=25
READ_CAP=40

# How fast "Ilya" types, in characters per second. 5 = ~45 words per minute.
# The indicator stays lit the whole time.
TYPING_CPS=5
TYPING_MIN=2
TYPING_MAX=45

# Chats answered in parallel. 1 disables threading (replies run in sequence).
WORKERS=4

# --- group chats -------------------------------------------------------
# The bot joins a group as an ordinary member. By default it only answers
# when @mentioned or when somebody replies to one of its messages - it still
# reads everything, so it knows what the conversation is about.
GROUPS_ENABLED=true

# true = answer every message in the group. Needs privacy mode disabled in
# BotFather (/setprivacy -> Disable, then re-add the bot to the group).
# Warning: burns the free Gemini quota fast in a busy group.
GROUP_REPLY_ALL=false

# Restrict to specific groups by chat id, comma separated. Empty = all.
GROUP_ALLOWLIST=

# Subjects he cannot let pass without comment. Russian stems match inflected
# forms ("бот" catches "боты", "ботами", but not "ботинок"). Comma separated,
# leave unset for the built-in list (bots, AI, modern tech, retro, nostalgia).
# GROUP_KEYWORDS=бот,ии,ретро,винил,bot,ai,retro

# Seconds before he may butt in on a keyword again. Being @mentioned or
# replied to ignores this entirely.
GROUP_KEYWORD_COOLDOWN=120

# Override the whole personality. Leave unset to use the built-in one.
# PERSONA=You are a polite assistant. Always reply in the customer's language.
