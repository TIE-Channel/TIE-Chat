# --- required ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ

# --- AI providers: set at least one key -------------------------------
# Tried in AI_ORDER; the first one that answers wins. A 429 on one becomes a
# half-second detour instead of a dead chat. Providers with no key are skipped,
# so you can add them one at a time.
#
#   gemini      aistudio.google.com/apikey       no card
#   groq        console.groq.com/keys            no card, very fast
#   cerebras    cloud.cerebras.ai                no card, high throughput
#   openrouter  openrouter.ai/keys               no card, many :free models
#   mistral     console.mistral.ai               no card, but Studio must be
#                                                activated with SMS verification;
#                                                free mode is ~1 request/second
#   nvidia      build.nvidia.com                 no card, NVIDIA NIM
#   huggingface huggingface.co/settings/tokens   no card, HF Inference
#
# GitHub Models was retired on 30 July 2026 - do not use it.
AI_ORDER=gemini,groq,cerebras,openrouter,nvidia,huggingface,mistral

# A provider that fails this many times in a row is skipped for PARK_MINUTES,
# so an exhausted daily quota stops costing a round trip on every message.
# /check always tests everyone and un-parks whoever recovered.
PARK_AFTER_FAILURES=3
PARK_MINUTES=10

# A single model that hits its own rate limit rests this long while the bot
# steps down to the next-best one. Models are ranked by likely quality across
# all providers, so it always answers with the cleverest one still available.
MODEL_COOLDOWN=600

# Quality is not the whole story: the bot also times every model it uses and
# discounts the slow ones. In a group, where a late reply lands after the
# conversation moved on, anything past SLOW_SECONDS drops sharply down the
# ladder; in a 1:1 chat the bot is faking a typing pause anyway, so slowness
# costs it almost nothing and the clever model still wins. Raise this if you
# would rather wait for the big model in groups too.
SLOW_SECONDS=8

GEMINI_API_KEY=AIza...
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=

# Model per provider - normally leave these alone. If a model name dies the
# bot asks the provider for a live one and switches by itself; the log tells
# you what it picked so you can pin it here.
# GROQ_MODEL=llama-3.1-8b-instant
# CEREBRAS_MODEL=llama-3.3-70b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# MISTRAL_MODEL=mistral-small-latest
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- lock it to you ---------------------------------------------------
# Your Telegram user id. WITHOUT THIS, anyone who knows the bot's username
# can attach it to their own Telegram Business account and answer their
# customers on your Gemini quota. Find it in the log line
# "business connection ... owner=NNNNN", or ask @userinfobot.
OWNER_ID=191609600

# Leave groups you are not a member of, instead of just staying quiet there.
GROUP_AUTO_LEAVE=false

# --- inline: call him into ANY chat -----------------------------------
# Type "@yourbot что-нибудь" in a chat the bot was never added to - a group, a
# channel, someone else's DM - and send it. It goes out as your own message
# ("via @yourbot" next to it) and fills in with the answer a second later.
# Typing costs nothing: the model runs once, when you send.
#
# TWO settings in @BotFather, and it does nothing without both:
#   /setinline         -> @yourbot -> send a placeholder, e.g. "что ответить..."
#   /setinlinefeedback -> @yourbot -> Enabled
# Without the second one Telegram never reports that the message was sent, so
# the placeholder is posted and never filled in - with no error anywhere. The
# bot watches for that pattern and says so in the log.
INLINE_ENABLED=true

# Who may summon him.
#   owner  - only you
#   shared - you, plus anyone who is in one of the groups you are in
#   all    - anybody who knows the username
#
# Telegram never tells a bot WHICH chat an inline query came from - there is no
# chat id in it, only the sender and a coarse "group/private/channel". So
# "only in chats I am in" cannot be enforced on the chat. It can be enforced on
# the person, which is the same guarantee from the other end: with "shared", a
# stranger who shares no room with you gets nothing.
#
# The list of your groups is learned as people talk in them (the Bot API cannot
# list a bot's chats) and is stored - in Redis when it is configured, otherwise
# in GROUPS_FILE - so a restart does not lock everyone but you out.
INLINE_ACCESS=shared

# What sits in the chat between sending and the answer landing, a second later.
INLINE_PLACEHOLDER=…

# Per-person ceiling, so an open inline bot cannot be drained in a minute.
INLINE_MAX_PER_MIN=6

# --- optional ---------------------------------------------------------
# Model to use. If your key can't access it, the bot auto-picks a flash model.
GEMINI_MODEL=gemini-3.8-flash

# Messages of context kept per chat (user + bot combined)
HISTORY_TURNS=20

# --- where conversations are kept between restarts --------------------
# Upstash Redis wins if both are set. It is the only option that survives a
# redeploy on a host with an ephemeral filesystem, which is most free hosts.
# Free tier, no card: console.upstash.com -> Create Database -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_PREFIX=tgbot
HISTORY_TTL_DAYS=30

# Fallback: a local file. Fine on a VPS or a mounted volume; on Render free it
# survives a crash but NOT a redeploy. Empty = memory only.
HISTORY_FILE=history.json
HISTORY_SAVE_EVERY=20
HISTORY_MAX_CHATS=300

# Which groups you are in, for the inline access test. Goes to Redis when it is
# configured; this file is only the fallback. Empty = forget on every restart.
GROUPS_FILE=groups.json

# Seconds between two auto-replies in the same chat
REPLY_COOLDOWN=2

# Telegram user IDs that should never get an auto-reply, comma separated
IGNORE_USER_IDS=

# Quote the customer's message in the reply. Off by default - replies arrive as
# ordinary messages. Set to true to get the quoted-reply style back.
QUOTE_REPLIES=false

TEMPERATURE=1.0

# Covers thinking AND the visible answer, and it is a ceiling, not a target.
# Kept high on purpose: this is the other way a reply gets cut off mid-sentence,
# and the spare budget also stops Gemini spending the whole allowance on
# thinking and returning nothing. Don't go below ~1024.
MAX_OUTPUT_TOKENS=4096

# Hard truncation, in characters. Both 0 = off, which is the default: length is
# the prompt's business (one line in a 1:1 chat, no limit in a group or inline),
# and cutting at a character count only ever chopped somebody off mid-sentence.
# sendMessage splits anything over Telegram's 4096 into several messages.
# Set a number to bring the old guillotine back.
#   REPLY_MAX_CHARS - 1:1 chats
#   ROOM_MAX_CHARS  - groups and inline
# (An inline reply is edited into a message that already exists and cannot be
# split, so that one is always capped at 4096 whatever you put here.)
REPLY_MAX_CHARS=0
ROOM_MAX_CHARS=0

# minimal | low | medium | high, or empty to let the model decide.
# A short chat reply needs no deep reasoning - low keeps it fast.
GEMINI_THINKING_LEVEL=low

GEMINI_TIMEOUT=45
LOG_LEVEL=INFO

# Where "Ilya" is, so he can answer "what time is it" and work out his own age.
# Deliberately never named in the prompt - naming a city makes him bring it up.
BOT_TZ=Europe/Berlin

# Longest incoming message forwarded to the model. Anything past this is cut.
MAX_INPUT_CHARS=4000

# Ignore messages older than this, in seconds. Matters on a host that sleeps:
# Telegram holds updates for ~24h and delivers the backlog on wake-up, and
# answering yesterday's "ты тут?" is worse than staying quiet. 0 = answer
# everything, however stale.
MAX_MESSAGE_AGE=3600

# Set by the host, not by you. When present the bot opens a health endpoint on
# that port - Render's free web services mark a deploy failed if nothing binds.
# PORT=10000

# Before anything shows in the chat: reaching the phone, unlocking it and
# reading the message. Pickup time is random between READ_MIN and READ_MAX,
# plus the time to read the incoming text at READ_CPS chars/sec.
READ_MIN=3
READ_MAX=12
READ_CPS=25
READ_CAP=40

# How fast "Ilya" types, in characters per second. 5 = ~45 words per minute.
# The indicator stays lit the whole time.
TYPING_CPS=5
TYPING_MIN=2
TYPING_MAX=45

# Chats answered in parallel. 1 disables threading (replies run in sequence).
WORKERS=4

# --- group chats -------------------------------------------------------
# The bot joins a group as an ordinary member. By default it only answers
# when @mentioned or when somebody replies to one of its messages - it still
# reads everything, so it knows what the conversation is about.
GROUPS_ENABLED=true

# true = answer every message in the group. Needs privacy mode disabled in
# BotFather (/setprivacy -> Disable, then re-add the bot to the group).
# Warning: burns the free Gemini quota fast in a busy group.
GROUP_REPLY_ALL=false

# Restrict to specific groups by chat id, comma separated. Empty = all.
GROUP_ALLOWLIST=

# Names people call him by. Exact words only ("бот" matches, "ботинок" does
# not). Being called by name skips the cooldown, but the judge still decides
# whether it was an address or just talk about bots.
# GROUP_NAMES=илья,илье,илью,ilya,бот,бота,боту,bot

# How he decides to speak up in a group:
#   context - a cheap second model reads the last lines and judges whether he
#             would naturally jump in
#   all     - every message
GROUP_TRIGGER=context

# The judge runs separately. Empty = pick a lite model automatically.
GROUP_JUDGE_MODEL=
GROUP_JUDGE_TURNS=12
GROUP_JUDGE_MIN_CHARS=10
GROUP_JUDGE_MAX_PER_MIN=8

# Seconds of enforced silence after he speaks in a group. 0 = none, which is
# the default: he only answers when the room is talking to him or about him,
# so there is nothing to ration.
GROUP_COOLDOWN=0

# May he join conversations that are not about him, when the judge thinks he
# has something worth adding? true = yes, with restraint; false = he only ever
# answers when addressed or discussed.
GROUP_JOIN_TOPICS=true

# Only used when GROUP_JOIN_TOPICS=false: with no name in the message, judge
# only if he took part in the last N lines.
GROUP_JUDGE_RECENT_TURNS=6

# Groups reply instantly. The read/typing pauses are for 1:1 chats, where
# someone is plainly answering you; in a room a 25-second pause just means
# the conversation moved on. Set true to use the same pacing in groups too.
GROUP_DELAY=false

# Override the whole personality. Leave unset to use the built-in one.
# PERSONA=You are a polite assistant. Always reply in the customer's language.
