# --- required ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ

# --- AI providers: set at least one key -------------------------------
# AI_ORDER only says which providers exist and which model each starts on. It
# is NOT the order replies are tried in: every model from every provider goes
# into one ladder ranked by quality, and everything that answers - all three
# modes, and the group judge - walks that ladder from the cleverest rung down.
# So a 429 on the best free tier is a step down to the next-best model
# anywhere, not a dead chat. Providers with no key are skipped, so you can add
# them one at a time.
#
#   gemini      aistudio.google.com/apikey       no card
#   groq        console.groq.com/keys            no card, very fast
#   cerebras    cloud.cerebras.ai                no card, high throughput
#   openrouter  openrouter.ai/keys               no card, many :free models
#   mistral     console.mistral.ai               no card, but Studio must be
#                                                activated with SMS verification;
#                                                free mode is ~1 request/second
#   nvidia      build.nvidia.com                 no card, NVIDIA NIM
#   huggingface huggingface.co/settings/tokens   no card, HF Inference
#
# GitHub Models was retired on 30 July 2026 - do not use it.
AI_ORDER=gemini,groq,cerebras,openrouter,nvidia,huggingface,mistral

# A provider that fails this many times in a row is skipped for PARK_MINUTES,
# so an exhausted daily quota stops costing a round trip on every message.
# /check always tests everyone and un-parks whoever recovered.
PARK_AFTER_FAILURES=3
PARK_MINUTES=10

# A single model that hits its own rate limit rests this long while the bot
# steps down to the next-best one. Models are ranked by likely quality across
# all providers, so it always answers with the cleverest one still available.
MODEL_COOLDOWN=600

# Quality is not the whole story: the bot also times every model it uses and
# discounts the slow ones. In a group, where a late reply lands after the
# conversation moved on, anything past SLOW_SECONDS drops sharply down the
# ladder; in a 1:1 chat the bot is faking a typing pause anyway, so slowness
# costs it almost nothing and the clever model still wins. Raise this if you
# would rather wait for the big model in groups too.
SLOW_SECONDS=8

GEMINI_API_KEY=AIza...
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=

# Model per provider - normally leave these alone. If a model name dies the
# bot asks the provider for a live one and switches by itself; the log tells
# you what it picked so you can pin it here.
# GROQ_MODEL=llama-3.1-8b-instant
# CEREBRAS_MODEL=llama-3.3-70b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# MISTRAL_MODEL=mistral-small-latest
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- lock it to you ---------------------------------------------------
# Your Telegram user id. WITHOUT THIS, anyone who knows the bot's username
# can attach it to their own Telegram Business account and answer their
# customers on your Gemini quota. Find it in the log line
# "business connection ... owner=NNNNN", or ask @userinfobot.
OWNER_ID=191609600

# Leave groups you are not a member of, instead of just staying quiet there.
GROUP_AUTO_LEAVE=false

# --- inline: call him into ANY chat -----------------------------------
# Type "@yourbot что-нибудь" in a chat the bot was never added to - a group, a
# channel, someone else's DM - and send it. It goes out as your own message
# ("via @yourbot" next to it) and fills in with the answer a second later.
# Typing costs nothing: the model runs once, when you send.
#
# You get a menu of three - Ответить / Коротко / Жёстко - and the one you pick
# is posted with the question and a "⏳ ответить" button. Tap that button and
# it fills in with the reply.
#
# ONE setting in @BotFather: /setinline -> @yourbot -> a placeholder line.
#
# /setinlinefeedback can be on or off, and nothing depends on it. Telegram only
# SAMPLES the "user chose this result" update - its own docs offer to report
# "1/10, 1/100 or 1/1000 of the results" - so when it does arrive the message
# fills itself in, and when it does not, the button does it.
INLINE_ENABLED=true

# Who may summon him.
#   owner  - only you
#   shared - you, plus anyone you demonstrably share a chat with: someone in
#            one of your groups, or (INLINE_TRUST_DM, below) someone you write
#            to in private on your business account
#   all    - anybody who knows the username
#
# Telegram never tells a bot WHICH chat an inline query came from - there is no
# chat id in it, only the sender and a coarse "group/private/channel". So
# "only in chats I am in" cannot be enforced on the chat. It can be enforced on
# the person, which is the same guarantee from the other end: with "shared", a
# stranger who shares no room with you gets nothing.
#
# The list of your groups is learned as people talk in them (the Bot API cannot
# list a bot's chats) and is stored - in Redis when it is configured, otherwise
# in GROUPS_FILE - so a restart does not lock everyone but you out. If the bot
# is in no groups of yours at all, the private-chat route below is the only one
# that will ever clear anybody.
INLINE_ACCESS=shared

# How long "this person shares a group with you" is trusted, in days. The
# verdict goes to Redis under REDIS_PREFIX:member:<user id>, so it survives a
# redeploy and everyone who could use the bot inline last week still can.
# It is also filled in for free: anyone who writes in one of your groups is
# recorded on the spot, with no membership call at all.
INLINE_MEMBER_DAYS=7

# How long a "no" is remembered, in minutes. Deliberately short: somebody who
# joins one of your groups tomorrow must not stay locked out for a week.
INLINE_MISS_MINUTES=15

# Does a 1:1 chat on your business account count as "shared", the way a group
# does? On by default, and for most people this is the route that actually
# works: a group only proves you stand in the same room as a hundred others,
# while a private conversation proves you two actually talk. It is also the
# only route to a friend you share no group with.
#
# Free, like the group route: every business message already names the person,
# so nothing is asked of Telegram. Both directions count - them writing to you
# and you writing to them - and the pass lasts INLINE_MEMBER_DAYS like any
# other. Only your OWN connection counts; somebody else's business account
# clears nobody.
#
# Turn it off if strangers write to your business account: with Secretary Mode
# the bot sees every 1:1 chat, so "anyone who ever messaged me" would include
# the spam.
INLINE_TRUST_DM=true

# What sits in the chat between sending and the answer landing.
INLINE_PLACEHOLDER=...

# Keep the line you asked about above the answer, labelled with who asked:
#
#   > Дмитрий                     <- bold, inside the quote
#   > ну и что ты на это скажешь  <- same quote block
#   Скажу, что вопрос ...         <- the answer, plain, right underneath
#
# Three options in the menu:
#   Ответить  the question goes to the model BARE - no persona, no house
#             style, no instructions at all. Whatever the model is like out of
#             the box is what you get
#   Коротко   also without the character, but with one instruction: answer in
#             one short sentence, no preamble, no sign-off
#   Жёстко    the only one still in character, and sharpened
#
# An inline message cannot quote anything - Telegram gives it no reply
# parameters - so without this the question vanishes the moment the placeholder
# is replaced, and the answer reads like a non sequitur to everyone else in the
# chat. The question goes in whole; the only thing that can shorten it is
# Telegram's own 4096-character ceiling on the entire message.
#
# The name is the asker's - not whoever taps the button, since anyone in the
# chat can - with the first letter capitalised and the rest left alone, so MAX
# stays MAX. No blank lines: the quote block separates the parts by itself.
INLINE_SHOW_QUESTION=true

# How each half is set off. IMPORTANT: Telegram has no font size for bot
# messages - none of these makes the letters bigger, they only change how much
# the block stands out. (The one thing that renders large in Telegram is a
# message of nothing but emoji.)
#
#   quote       quote block with a vertical bar - the default
#   expandable  the same, collapsed behind "show more" past a few lines.
#               Good when answers run long
#   pre         a code panel: filled background, monospace, copy button. The
#               heaviest-looking block available - but monospace Cyrillic reads
#               oddly, and the copy button is noise here
#   bold        no block, just heavier text. The closest thing to "bigger"
#   plain       nothing at all
INLINE_BLOCK=quote

# The answer sits plainly under the quoted question. Same values as
# INLINE_BLOCK if you would rather set it off too.
INLINE_BLOCK_ANSWER=plain

# Per-person ceiling, so an open inline bot cannot be drained in a minute.
INLINE_MAX_PER_MIN=6

# --- talking to the bot in its own chat -------------------------------
# Open @yourbot and write to it. It answers you - and only you: OWNER_ID is
# checked exactly as it is everywhere else, and anyone else who finds the bot
# is turned away with one line.
#
# This is NOT the character. The question goes to the model exactly as typed,
# with no persona, no house style, no date and no "answer in one line" - the
# same deal as the inline "Ответить" option. Whatever the model is like out of
# the box is what you get here, which is what makes it useful as a plain
# assistant while Ilya keeps answering your customers.
#
# Commands still work regardless of this setting: /status, /check, /reset.
DM_CHAT_ENABLED=true

# Keep the thread, so "а покороче?" has something to refer back to. This is
# the one difference from an inline summon, which is deliberately stateless.
# HISTORY_TURNS caps the length; /reset in the chat empties it; the transcript
# lives under its own key ("dm:<chat id>") and never touches a customer chat.
# false = every message stands on its own.
DM_CHAT_MEMORY=true

# --- what the raw modes know about here and now -----------------------
# "Ответить", "Коротко" and the bot's own chat send your question with nothing
# wrapped around it - which also meant the model had no idea what day it was.
# A short block of FACTS now goes in front of the question in those modes: the
# time, who is asking, and - for you only - where you are. Still no persona,
# no house style, no instructions about how to answer.
#
# The ceiling, plainly: Telegram gives a bot NO device data. No battery, no
# apps, no calendar, no clock from your phone, and no location unless you
# deliberately share one. Everything below is what actually exists.
RAW_CONTEXT=true

# Where you are, in words, when no pin has been shared. Used verbatim, and
# only in answers to you. Example: OWNER_LOCATION=Berlin, Germany
OWNER_LOCATION=

# How long a shared pin counts as "where you are now". A pin from yesterday is
# worse than none: it reads as current and is not. Share a location in the
# bot's chat (paperclip -> Location) to set one; a LIVE location keeps itself
# up to date for as long as Telegram runs it.
LOCATION_TTL_HOURS=12

# Your own profile, as Telegram serves it: bio, business address, opening
# hours, birthday. Read once with getChat and kept this many hours. You
# published all of it yourself, so it goes into EVERY mode - a customer asking
# "when are you open" should get the real answer, not an invented one.
PROFILE_HOURS=24

# The unpublished half - the pin you shared and your /ctx note - goes only
# where you alone read the answer: your chat with the bot, and your own inline
# summon. In a group or a customer chat somebody else reads it, and a model
# told your coordinates can repeat them out loud. Set true to send it there
# too, if that is what you want.
CONTEXT_PRIVATE_EVERYWHERE=false

# Anything else you want in that block goes in by hand, in the bot's chat:
#   /ctx сижу на macbook, до пятницы в Праге
#   /ctx            show what is currently held
#   /ctx -          clear it
#   /where          print the exact block the model is given
# It survives a restart in Redis. This is the honest substitute for "read my
# computer": the bot cannot, so you tell it.

# --- optional ---------------------------------------------------------
# Model to use. If your key can't access it, the bot auto-picks a flash model.
GEMINI_MODEL=gemini-3.8-flash

# Messages of context kept per chat (user + bot combined)
HISTORY_TURNS=20

# --- what happens to messages that fall out of that window --------------
# Without this they were simply forgotten: a chat that ran past HISTORY_TURNS
# lost its beginning, along with the name, the price and the decision agreed
# there. With it, the oldest batch is folded into a running set of NOTES
# before it is dropped, and those notes ride along with every later question.
# So the bot keeps the recent conversation word for word AND the gist of
# everything before it, at a fixed cost in prompt size.
#
# The notes are rewritten by the CHEAP end of the model ladder, like the group
# judge - condensing is mechanical work, and a call spent on the clever model
# is one the actual answers no longer have. It runs after the reply has gone
# out, so it costs the person waiting nothing.
#
# In a group this happens after a reply, not after every message: summarising
# a room the bot never speaks in would burn quota for nothing.
#
#   /memory   in the bot's chat: what is kept word for word, and the notes
#   /reset    clears both
SUMMARY_ENABLED=true

# How many turns are folded in at a time. Bigger = fewer, better-informed
# summarisation calls; smaller = notes updated more often.
SUMMARY_BATCH=8

# Ceiling on the notes themselves - they travel with every question in that
# chat, so they have to stay worth their space.
SUMMARY_MAX_CHARS=1200

# --- where conversations are kept between restarts --------------------
# Upstash Redis wins if both are set. It is the only option that survives a
# redeploy on a host with an ephemeral filesystem, which is most free hosts.
# Free tier, no card: console.upstash.com -> Create Database -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_PREFIX=tgbot
HISTORY_TTL_DAYS=30

# Fallback: a local file. Fine on a VPS or a mounted volume; on Render free it
# survives a crash but NOT a redeploy. Empty = memory only.
HISTORY_FILE=history.json
HISTORY_SAVE_EVERY=20
HISTORY_MAX_CHATS=300

# Which groups you are in, for the inline access test. Goes to Redis when it is
# configured; this file is only the fallback. Empty = forget on every restart.
GROUPS_FILE=groups.json

# Seconds between two auto-replies in the same chat. 0 = off, the default: a
# 1:1 chat already throws away the older draft when a newer message arrives,
# and in a room two people addressing him at once both deserve an answer.
REPLY_COOLDOWN=0

# Telegram user IDs that should never get an auto-reply, comma separated
IGNORE_USER_IDS=

# Quote the customer's message in the reply. Off by default - replies arrive as
# ordinary messages. Set to true to get the quoted-reply style back.
QUOTE_REPLIES=false

# Typographic punctuation is flattened to what a phone keyboard actually types:
# em/en dashes -> hyphen, curly quotes and guillemets -> straight quotes, the
# single-character ellipsis -> three dots, bullets -> hyphen, non-breaking and
# hair spaces -> a normal space, zero-width characters removed. This is NOT
# "ASCII only" - the text is Russian and stays Russian. It is the punctuation
# no phone keyboard puts within reach, which is one of the surest tells that a
# machine wrote the line. The persona asks for the same thing; this enforces
# it. See TYPOGRAPHY / plain_punctuation() in bot.py. All three modes.

TEMPERATURE=1.0

# Covers thinking AND the visible answer, and it is a ceiling, not a target.
# Kept high on purpose: this is the other way a reply gets cut off mid-sentence,
# and the spare budget also stops Gemini spending the whole allowance on
# thinking and returning nothing. Don't go below ~1024.
MAX_OUTPUT_TOKENS=4096

# Hard truncation, in characters. Both 0 = off, which is the default: length is
# the prompt's business (one line in a 1:1 chat, no limit in a group or inline),
# and cutting at a character count only ever chopped somebody off mid-sentence.
# sendMessage splits anything over Telegram's 4096 into several messages.
# Set a number to bring the old guillotine back.
#   REPLY_MAX_CHARS - 1:1 chats
#   ROOM_MAX_CHARS  - groups and inline
# (An inline reply is edited into a message that already exists and cannot be
# split, so that one is always capped at 4096 whatever you put here.)
REPLY_MAX_CHARS=0
ROOM_MAX_CHARS=0

# minimal | low | medium | high, or empty to let the model decide.
# A short chat reply needs no deep reasoning - low keeps it fast.
GEMINI_THINKING_LEVEL=low

GEMINI_TIMEOUT=45
LOG_LEVEL=INFO

# Where "Ilya" is, so he can answer "what time is it" and work out his own age.
# Deliberately never named in the prompt - naming a city makes him bring it up.
BOT_TZ=Europe/Berlin

# Longest incoming message forwarded to the model. Anything past this is cut.
MAX_INPUT_CHARS=4000

# Ignore messages older than this, in seconds. Matters on a host that sleeps:
# Telegram holds updates for ~24h and delivers the backlog on wake-up, and
# answering yesterday's "ты тут?" is worse than staying quiet. 0 = answer
# everything, however stale.
MAX_MESSAGE_AGE=3600

# Set by the host, not by you. When present the bot opens a health endpoint on
# that port - Render's free web services mark a deploy failed if nothing binds.
# PORT=10000

# Before anything shows in the chat: reaching the phone, unlocking it and
# reading the message. Pickup time is random between READ_MIN and READ_MAX,
# plus the time to read the incoming text at READ_CPS chars/sec.
READ_MIN=3
READ_MAX=12
READ_CPS=25
READ_CAP=40

# How fast "Ilya" types, in characters per second. 5 = ~45 words per minute.
# The indicator stays lit the whole time.
TYPING_CPS=5
TYPING_MIN=2
TYPING_MAX=45

# Chats answered in parallel. 1 disables threading (replies run in sequence).
WORKERS=4

# --- group chats -------------------------------------------------------
# The bot joins a group as an ordinary member. By default it only answers
# when @mentioned or when somebody replies to one of its messages - it still
# reads everything, so it knows what the conversation is about.
GROUPS_ENABLED=true

# true = answer every message in the group. Needs privacy mode disabled in
# BotFather (/setprivacy -> Disable, then re-add the bot to the group).
# Warning: burns the free Gemini quota fast in a busy group.
GROUP_REPLY_ALL=false

# Restrict to specific groups by chat id, comma separated. Empty = all.
# --- forum groups (topics) --------------------------------------------
# In a forum, the answer must carry the topic it was asked in or Telegram
# files it under General, where nobody who asked is looking. The bot sends
# message_thread_id whenever the incoming message has one, and if Telegram
# refuses it, re-sends without it rather than losing the answer.
#
# This is the second guarantee: in a topic, answer as a reply to the message
# that summoned him. A reply is anchored to a message, and Telegram puts it in
# that message's topic regardless of what was worked out about thread ids -
# so even a missing or refused id still lands in the right place.
#
# Only inside topics; an ordinary group is unchanged and still not quoted.
# Set false to rely on message_thread_id alone.
GROUP_QUOTE_IN_TOPICS=true

GROUP_ALLOWLIST=

# Names people call him by. Exact words only ("бот" matches, "ботинок" does
# not). Being called by name skips the cooldown, but the judge still decides
# whether it was an address or just talk about bots.
# GROUP_NAMES=илья,илье,илью,ilya,бот,бота,боту,bot

# How he decides to speak up in a group:
#   context - a cheap second model reads the last lines and judges whether he
#             would naturally jump in
#   all     - every message
GROUP_TRIGGER=context

# The judge walks the same ladder as replies, but from the other end: the
# DUMBEST rung first, climbing only when one turns out unable to produce a
# usable verdict. A yes/no does not need the clever model, and every judge call
# spent on one is a call the actual answers no longer have.
# Empty = just start at the cheap end. Set a model name to try that one first;
# if it is not on the ladder the bot says so at startup and ignores it.
GROUP_JUDGE_MODEL=
GROUP_JUDGE_TURNS=12
GROUP_JUDGE_MIN_CHARS=10
GROUP_JUDGE_MAX_PER_MIN=8

# The judge starts at the cheap end of the ladder, and that end collects models
# for two reasons: being small, and being unrecognisable. A name the quality
# heuristic cannot place scores near zero - which is where an Arabic-only
# model, an agentic "compound" system and a reasoning model all landed, each
# picked as judge ahead of an ordinary 8B chat model. Rungs under this floor
# are skipped for judging (they stay available for replies). Models that
# narrate their reasoning are skipped too: the monologue eats the verdict.
GROUP_JUDGE_MIN_QUALITY=40

# Seconds of enforced silence after he speaks in a group. 0 = none, which is
# the default: he only answers when the room is talking to him or about him,
# so there is nothing to ration.
GROUP_COOLDOWN=0

# May he join conversations that are not about him, when the judge thinks he
# has something worth adding? true = yes, with restraint; false = he only ever
# answers when addressed or discussed.
GROUP_JOIN_TOPICS=true

# Only used when GROUP_JOIN_TOPICS=false: with no name in the message, judge
# only if he took part in the last N lines.
GROUP_JUDGE_RECENT_TURNS=6

# Groups reply instantly. The read/typing pauses are for 1:1 chats, where
# someone is plainly answering you; in a room a 25-second pause just means
# the conversation moved on. Set true to use the same pacing in groups too.
GROUP_DELAY=false

# Override the whole personality. Leave unset to use the built-in one.
# PERSONA=You are a polite assistant. Always reply in the customer's language.
